{
  "name": "atpassport-extension",
  "version": "0.1.5",
  "type": "module",
  "description": "@passport handle auto-filler and clipboard copier.",
  "private": true,
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "postinstall": "wxt prepare",
    "compile": "tsc --noEmit",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "test": "vitest run"
  },
  "dependencies": {
    "lucide-react": "^1.7.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/chrome": "^0.1.39",
    "@types/node": "^25.5.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "3.1.0",
    "@wxt-dev/module-react": "^1.1.2",
    "@wxt-dev/storage": "^1.1.2",
    "chrome-webstore-upload-cli": "^3.5.0",
    "eslint": "^9.39.4",
    "jsdom": "^29.0.2",
    "node-forge": "1.4.0",
    "picomatch": "4.0.4",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.6",
    "vitest": "^4.1.3",
    "wxt": "^0.19.26"
  }
}