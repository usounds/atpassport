{
  "name": "atpassport-extension",
  "version": "0.3.0",
  "author": "usounds.work",
  "type": "module",
  "description": "@passport handle auto-filler and clipboard copier.",
  "private": true,
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "update": "npx ncu -u -x eslint,typescript && pnpm install",
    "build": "wxt build && wxt build -b firefox",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip && wxt zip -b firefox",
    "submit:chrome": "pnpm zip && npx publish-browser-extension@latest --chrome-zip .output/atpassport-extension-$npm_package_version-chrome.zip",
    "submit:firefox": "pnpm zip && npx publish-browser-extension@latest --firefox-zip .output/atpassport-extension-$npm_package_version-firefox.zip --firefox-sources-zip .output/atpassport-extension-$npm_package_version-sources.zip --firefox-skip-submit-review",
    "submit:firefox:auto": "pnpm zip && npx publish-browser-extension@latest --firefox-zip .output/atpassport-extension-$npm_package_version-firefox.zip --firefox-sources-zip .output/atpassport-extension-$npm_package_version-sources.zip",
    "postinstall": "wxt prepare",
    "compile": "tsc --noEmit",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "test": "vitest run",
    "test:e2e": "wxt build && playwright test"
  },
  "dependencies": {
    "lucide-react": "^1.47.0",
    "react": "19.2.5",
    "react-dom": "19.2.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/chrome": "^0.3.0",
    "@types/node": "^26.6.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.1",
    "@wxt-dev/module-react": "^1.2.2",
    "@wxt-dev/storage": "^1.2.9",
    "chrome-webstore-upload-cli": "^4.0.1",
    "eslint": "^9.39.5",
    "jsdom": "^30.1.0",
    "picomatch": "4.0.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^4.1.11",
    "web-ext": "^10.6.0",
    "wxt": "^0.21.4"
  }
}
