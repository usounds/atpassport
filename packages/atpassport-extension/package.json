{
  "name": "atpassport-extension",
  "version": "0.2.4",
  "author": "usounds.work",
  "type": "module",
  "description": "@passport handle auto-filler and clipboard copier.",
  "private": true,
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "update": "pnpm dlx npm-check-updates -u && pnpm install && pnpm update",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip && wxt zip -b firefox",
    "submit:chrome": "pnpm zip && npx publish-browser-extension@latest --chrome-zip .output/atpassport-extension-$npm_package_version-chrome.zip",
    "submit:firefox": "pnpm zip && npx publish-browser-extension@latest --firefox-zip .output/atpassport-extension-$npm_package_version-firefox.zip --firefox-sources-zip .output/atpassport-extension-$npm_package_version-sources.zip",
    "postinstall": "wxt prepare",
    "compile": "tsc --noEmit",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "test": "vitest run",
    "test:e2e": "wxt build && playwright test"
  },
  "dependencies": {
    "lucide-react": "^1.18.0",
    "react": "19.2.5",
    "react-dom": "19.2.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/chrome": "^0.1.43",
    "@types/node": "^25.9.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "@wxt-dev/module-react": "^1.2.2",
    "@wxt-dev/storage": "^1.2.8",
    "chrome-webstore-upload-cli": "^3.5.0",
    "eslint": "^10.5.0",
    "jsdom": "^29.1.1",
    "picomatch": "4.0.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.8",
    "wxt": "^0.20.26"
  }
}
