{
  "name": "@atpassport/client",
  "version": "0.1.31",
  "description": "@passport client library for integrating secure handle input assist into applications.",
  "keywords": [
    "atproto",
    "bluesky",
    "handle-manager"
  ],
  "author": "usounds.work",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usounds/atpassport.git",
    "directory": "packages/atpassport-client"
  },
  "homepage": "https://github.com/usounds/atpassport/tree/main/packages/atpassport-client#readme",
  "bugs": {
    "url": "https://github.com/usounds/atpassport/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!dist/__tests__",
    "README.md",
    "SECURITY.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup src/index.ts src/core.ts src/ui.tsx --format cjs,esm --dts --clean",
    "deploy": "pnpm run test && pnpm build && npm version patch && npm publish --access public",
    "update": "npx ncu -u -x eslint && pnpm install",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.mjs",
      "require": "./dist/core.js"
    },
    "./ui": {
      "types": "./dist/ui.d.ts",
      "import": "./dist/ui.mjs",
      "require": "./dist/ui.js"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.6.0",
    "@types/react": "19.2.14",
    "@vitest/coverage-v8": "4.1.4",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "jsdom": "^29.0.2",
    "picomatch": "4.0.4",
    "react": "^19.2.5",
    "tsup": "^8.5.1",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.1",
    "vitest": "^4.1.4"
  }
}
