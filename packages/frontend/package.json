    "next": "^16.4.5",
    "next-intl": "4.14.9",
    "nextjs-toploader": "^3.9.17",
    "qrcode.react": "^4.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-icons": "^5.7.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sst": "^4.17.2",
    "uuid": "^14.0.3",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
