    "@atcute/lexicons": "^1.3.1",
    "@atcute/oauth-browser-client": "^3.0.1",
    "@atpassport/client": "workspace:*",
    "@aws-sdk/client-dynamodb": "^3.1045.0",
    "@aws-sdk/lib-dynamodb": "^3.1045.0",
    "@emotion/react": "^11.14.0",
