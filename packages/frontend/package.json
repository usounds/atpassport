    "@vitest/coverage-v8": "^5.1.0",
    "babel-loader": "^10.1.1",
    "babel-plugin-istanbul": "^8.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.5",
    "istanbul-lib-coverage": "^3.2.2",
