{
  "name": "frontend",
  "version": "0.2.5",
  "author": "usounds.work",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001 -H 0.0.0.0",
    "dev:local": "npx sst dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:coverage": "node scripts/prepare-e2e-coverage.mjs && E2E_COVERAGE=true playwright test --project=chromium && node scripts/report-e2e-coverage.mjs",
    "test:e2e:ui": "playwright test --ui",
    "check": "pnpm test && pnpm lint && pnpm run test:e2e && pnpm build",
    "deploy": "pnpm test && npx sst deploy --stage production",
    "update": "npx ncu -u -x eslint && pnpm install",
    "lint": "eslint"
  },
  "dependencies": {
    "@atcute/bluesky": "^3.3.5",
