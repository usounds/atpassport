    "@atcute/lexicons": "^2.1.1",
    "@atcute/oauth-browser-client": "^5.1.0",
    "@atpassport/client": "workspace:*",
    "@aws-sdk/client-dynamodb": "^3.1164.0",
    "@aws-sdk/lib-dynamodb": "^3.1164.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mantine/core": "^9.8.0",
    "@mantine/hooks": "^9.8.0",
    "@mantine/notifications": "^9.8.0",
    "@tabler/icons-react": "^3.51.0",
